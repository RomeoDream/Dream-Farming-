// Generated by tools/build_lsl.py; edit src/ for development.
// Dream Garden 0.4.0 farm manure collection point.
// Standalone RP: one unit per animal per six real hours, capped at 1000 stored.
// External livestock integration: set ANIMALS=0 and use the same-root linked API.
integer ANIMALS=1; // 0..100; not automatic detection of third-party livestock.
integer INTERVAL_SECONDS=21600;
string DATA="dreamgarden:farm:v1";
// version,owner,manure,exchange,lastUTC,seconds remainder,last producer seq,last amount.
list S;
integer fault;
// Shared exchange state lives inside the endpoint's SINGLE atomic saved record.
// X: 0 version,1 persistent endpoint ID,2 receive nonce,3 expiry,4 outgoing,
// 5 incoming,6 unsettled receipt book,7 runner progress,8 spread out,9 accept spread,
// 10 rooted runners/plugs,11 clone genotype,12 disease carried by clones,13 mature compost stock.
integer XNET=-163847022;
list X;
integer xh;
integer xc;
integer xu;
string xpage;
list xb;
string xkind;
integer xamount;
string xscan;
string xpayload;
string xmode;
integer xscanUntil;
list xoffers; // object UUID, endpoint ID, receive nonce, distance, name
key xpeer;
integer xlastSend;
// Bulk endpoints store exchange journal and stock in one atomic record.
integer uuid(string value){key k=(key)value;if(k)return TRUE;return FALSE;}
integer near(key id,float distance)
{
    list d=llGetObjectDetails(id,[OBJECT_POS]);if(llGetListLength(d)!=1)return FALSE;
    return llVecDist(llList2Vector(d,0),llGetPos())<=distance;
}
integer bi(integer i){return llList2Integer(S,i);}
float bf(integer i){return llList2Float(S,i);}
bput(integer i,list v){S=llListReplaceList(S,v,i,i);}
float limit(float v,float lo,float hi){if(v<lo)return lo;if(v>hi)return hi;return v;}
integer save(list before)
{
    bput(3,[llList2Json(JSON_ARRAY,X)]);
    integer r=llLinksetDataWrite(DATA,llList2Json(JSON_ARRAY,S));
    if(r!=LINKSETDATA_OK && r!=LINKSETDATA_NOUPDATE)
    {S=before;X=llJson2List(llList2String(S,3));fault=TRUE;llOwnerSay("Storage failed. Preserve saved data, repair free space, then reset.");render();return FALSE;}
    render();return TRUE;
}
integer isCarrier(){return TRUE;}
integer spreadNear(key source,string raw){return FALSE;}
integer spreadReady(){return FALSE;}
integer cargoReady(){return advance();}
boot()
{
    fault=FALSE;xresetUI();X=xfresh();fresh();
    string raw=llLinksetDataRead(DATA);
    if(raw!="")
    {
        list a=llJson2List(raw);
        if(llJsonValueType(raw,[])!=JSON_ARRAY || !valid(a))fault=TRUE;
        if(fault){llOwnerSay("Invalid bulk record preserved. Do not delete saved data.");render();return;}
        S=a;X=llJson2List(llList2String(S,3));
        if(llList2Key(S,1)!=llGetOwner())
        {
            if(xbusy()){fault=TRUE;llOwnerSay("Return to the original owner to finish the pending transfer. Contents preserved.");}
            else {list before=S;bput(1,[(string)llGetOwner()]);xput(2,[""]);xput(3,[0]);save(before);}
        }
    }
    else save(S);
    advance();render();llSetTimerEvent(30.0);
}
fresh(){S=[1,(string)llGetOwner(),0,llList2Json(JSON_ARRAY,X),llGetUnixTime(),0,0,0];}
integer valid(list a)
{
    if(llGetListLength(a)!=8 || llList2Integer(a,0)!=1 || !uuid(llList2String(a,1)) || !xvalid(llJson2List(llList2String(a,3))))return FALSE;
    integer i;for(i=0;i<8;++i)
    {integer t=llGetListEntryType(a,i);if(i==1 || i==3){if(t!=TYPE_STRING)return FALSE;}else if(t!=TYPE_INTEGER)return FALSE;}
    if(llList2Integer(a,2)<0 || llList2Integer(a,2)>1000 || llList2Integer(a,4)<=0)return FALSE;
    if(llList2Integer(a,5)<0 || llList2Integer(a,5)>=INTERVAL_SECONDS || llList2Integer(a,6)<0 || llList2Integer(a,6)>1000000000)return FALSE;
    return llList2Integer(a,7)>=0 && llList2Integer(a,7)<=100;
}
render()
{
    string text="Dream Garden farm\nRaw manure: "+(string)bi(2)+" units\nSend contents packs up to ten units.";
    if(ANIMALS==0)text+="\nLinked livestock mode";else text+="\nStandalone RP livestock: "+(string)ANIMALS;
    if(xbusy())text+="\nTRANSFER PENDING";if(fault)text+="\nSTORAGE LOCK";
    llSetText(text,<0.6,0.45,0.25>,1.0);
}
integer advance()
{
    if(fault)return FALSE;
    if(ANIMALS<0 || ANIMALS>100 || INTERVAL_SECONDS<60){fault=TRUE;llOwnerSay("Invalid farm configuration.");return FALSE;}
    integer elapsed=llGetUnixTime()-bi(4);if(elapsed<=0)return TRUE;
    list before=S;bput(4,[llGetUnixTime()]);
    if(!xbusy() && ANIMALS>0)
    {
        // Cap at one year before arithmetic to avoid integer overflow after long absences.
        if(elapsed>31536000)elapsed=31536000;
        integer total=bi(5)+elapsed;integer cycles=total/INTERVAL_SECONDS;
        integer n=bi(2)+cycles*ANIMALS;if(n>1000)n=1000;
        bput(2,[n]);bput(5,[total%INTERVAL_SECONDS]);
    }
    return save(before);
}
string cargoMake(string kind,integer amount,string mode)
{
    integer n=bi(2);if(n<1)return "";if(n>10)n=10;
    return llList2Json(JSON_ARRAY,[1,"General","manure",n,"",0.0,"",llGetUnixTime()]);
}
integer cargoCanReceive(string raw,string mode){return FALSE;}
cargoDebit(string raw,string mode){bput(2,[bi(2)-llList2Integer(llJson2List(raw),3)]);}
cargoCredit(string raw){}
string xs(integer i){return llList2String(X,i);}
integer xi(integer i){return llList2Integer(X,i);}
xput(integer i,list v){X=llListReplaceList(X,v,i,i);}
list xfresh(){return [1,(string)llGenerateKey(),"",0,"","","[]",0.0,0,0,0,"",0.0,0];}
integer xbusy(){return xs(4)!="" || xs(5)!="";}
integer xvalid(list v)
{
    if(llGetListLength(v)!=14 || llList2Integer(v,0)!=1 || !uuid(llList2String(v,1)))return FALSE;
    integer i;
    for(i=0;i<14;++i)
    {
        integer t=llGetListEntryType(v,i);
        if(i==1 || i==2 || (i>=4 && i<=6) || i==11){if(t!=TYPE_STRING)return FALSE;}
        else if(t!=TYPE_INTEGER && t!=TYPE_FLOAT)return FALSE;
    }
    list integerFields=[0,3,8,9,10,13];
    for(i=0;i<llGetListLength(integerFields);++i)if(llGetListEntryType(v,llList2Integer(integerFields,i))!=TYPE_INTEGER)return FALSE;
    if(llList2String(v,4)!="" && llList2String(v,5)!="")return FALSE;
    if(llList2Integer(v,13)<0 || llList2Integer(v,13)>1000000)return FALSE;
    if(llList2String(v,2)!="" && !uuid(llList2String(v,2)))return FALSE;
    if(llList2Integer(v,3)<0 || llList2Float(v,7)<0.0 || llList2Float(v,7)>24.0)return FALSE;
    if(llList2Integer(v,8)<0 || llList2Integer(v,8)>1 || llList2Integer(v,9)<0 || llList2Integer(v,9)>1)return FALSE;
    if(llList2Integer(v,10)<0 || llList2Integer(v,10)>1000000 || llList2Float(v,12)<0.0 || llList2Float(v,12)>100.0)return FALSE;
    if(llList2Integer(v,10)>0 && !uuid(llList2String(v,11)))return FALSE;
    for(i=4;i<=5;++i)
    {
        string r=llList2String(v,i);
        if(r!="")
        {
            if(llJsonValueType(r,[])!=JSON_ARRAY)return FALSE;
            list a=llJson2List(r);
            {
                // tx, peer stable ID, owner at start, arm, cargo, mode, phase
                if(llGetListLength(a)!=7)return FALSE;
                integer j;for(j=0;j<4;++j)if(!uuid(llList2String(a,j)))return FALSE;
                if(!cargoValid(llList2String(a,4)))return FALSE;
                if(llListFindList(["manual","spread"],[llList2String(a,5)])<0)return FALSE;
                if(llGetListEntryType(a,6)!=TYPE_INTEGER || llList2Integer(a,6)<1 || llList2Integer(a,6)>4 || (i==5 && llList2Integer(a,6)!=1))return FALSE;
            }
        }
    }
    list receipts=llJson2List(llList2String(v,6));
    if(llJsonValueType(llList2String(v,6),[])!=JSON_ARRAY || llGetListLength(receipts)>96 || llGetListLength(receipts)%3!=0)return FALSE;
    for(i=0;i<llGetListLength(receipts);i+=3)
    {if(!uuid(llList2String(receipts,i)) || !uuid(llList2String(receipts,i+1)) || llListFindList(["DONE","ABORTED"],[llList2String(receipts,i+2)])<0)return FALSE;}
    return TRUE;
}
list xreceipt(string sid)
{
    list r=llJson2List(xs(6));integer i;
    for(i=0;i<llGetListLength(r);i+=3)if(llList2String(r,i)==sid)return llList2List(r,i,i+2);
    return [];
}
integer xspace(string sid){return llGetListLength(xreceipt(sid))>0 || llGetListLength(llJson2List(xs(6)))<96;}
xremember(string sid,string tx,string outcome)
{
    list r=llJson2List(xs(6));integer i;
    for(i=0;i<llGetListLength(r);i+=3)if(llList2String(r,i)==sid){r=llListReplaceList(r,[sid,tx,outcome],i,i+2);xput(6,[llList2Json(JSON_ARRAY,r)]);return;}
    r+=[sid,tx,outcome];xput(6,[llList2Json(JSON_ARRAY,r)]);
}
integer cargoValid(string raw)
{
    if(llStringLength(raw)>600 || llJsonValueType(raw,[])!=JSON_ARRAY)return FALSE;
    list c=llJson2List(raw);
    if(llGetListLength(c)!=8 || llGetListEntryType(c,0)!=TYPE_INTEGER || llList2Integer(c,0)!=1)return FALSE;
    if(llListFindList(["Lettuce","Carrot","Tomato","Strawberry","Corn","Pumpkin","Rose","Sunflower","Apple","Tree","Grass","General"],[llList2String(c,1)])<0)return FALSE;
    string k=llList2String(c,2);
    if(llListFindList(["seed","cutting","runner","produce","rootstock","leaves","logs","flower","plant","manure","compost"],[k])<0)return FALSE;
    if(llGetListEntryType(c,3)!=TYPE_INTEGER || llList2Integer(c,3)<1 || llList2Integer(c,3)>100)return FALSE;
    if(llGetListEntryType(c,7)!=TYPE_INTEGER || llList2Integer(c,7)<=0 || llList2Integer(c,7)>llGetUnixTime())return FALSE;
    integer i;for(i=0;i<8;++i)
    {
        integer t=llGetListEntryType(c,i);
        if(i==1 || i==2 || i==4 || i==6){if(t!=TYPE_STRING)return FALSE;}
        else if(t!=TYPE_INTEGER && t!=TYPE_FLOAT)return FALSE;
    }
    if(llList2Float(c,5)<0.0 || llList2Float(c,5)>100.0)return FALSE;
    if(llList2String(c,1)=="General" && k!="manure" && k!="compost" && k!="leaves" && k!="logs")return FALSE;
    if(k=="cutting" || k=="runner" || k=="plant")
    {if(!uuid(llList2String(c,4)))return FALSE;}
    if(k=="cutting" && llListFindList(["Rose","Apple","Tree"],[llList2String(c,1)])<0)return FALSE;
    if(k=="runner" && llListFindList(["Strawberry","Grass"],[llList2String(c,1)])<0)return FALSE;
    if(k=="plant")
    {
        if(llList2Integer(c,3)!=1 || llJsonValueType(llList2String(c,6),[])!=JSON_ARRAY)return FALSE;
        list p=llJson2List(llList2String(c,6));
        if(llGetListLength(p)!=11)return FALSE;
        for(i=0;i<11;++i)
        {integer t=llGetListEntryType(p,i);if(t!=TYPE_INTEGER && t!=TYPE_FLOAT)return FALSE;}
        list ii=[0,4,5,7];
        for(i=0;i<4;++i)if(llGetListEntryType(p,llList2Integer(ii,i))!=TYPE_INTEGER)return FALSE;
        if(llList2Integer(p,0)<0 || llList2Integer(p,0)>4 || llList2Float(p,1)<0.0 || llList2Float(p,1)>1000000.0)return FALSE;
        if(llList2Float(p,2)<=0.0 || llList2Float(p,2)>100.0 || llList2Float(p,3)<0.0 || llList2Float(p,3)>1000000.0)return FALSE;
        if(llList2Integer(p,4)<0 || llList2Integer(p,4)>1000000 || llList2Integer(p,5)<0 || llList2Integer(p,5)>1)return FALSE;
        if(llList2Float(p,6)<0.0 || llList2Float(p,6)>1000000.0 || llList2Integer(p,7)<0 || llList2Integer(p,7)>3)return FALSE;
        if(llList2Float(p,10)<0.0 || llList2Float(p,10)>100.0)return FALSE;
        if(llList2Float(p,8)<0.0 || llList2Float(p,8)>100.0 || llList2Float(p,9)<0.0 || llList2Float(p,9)>=2419200.0)return FALSE;
    }
    else if(llList2String(c,6)!="")return FALSE;
    return TRUE;
}
integer xmemory(){return llGetFreeMemory()>=12288;}
integer xownerNear(){return llGetAgentSize(llGetOwner())!=ZERO_VECTOR && near(llGetOwner(),8.0);}
xsend(key target,string op,string tx,string to,string arm,string cargo,string mode)
{
    string m=llList2Json(JSON_OBJECT,["v",1,"op",op,"tx",tx,"sid",xs(1),"to",to,"arm",arm,"cargo",cargo,"mode",mode]);
    if(llStringLength(llStringToBase64(m))>1364){llOwnerSay("Transfer message exceeds chat limit; operation held.");return;}
    if(target==NULL_KEY)llRegionSay(XNET,m);else llRegionSayTo(target,XNET,m);
}
xclose(){if(xh)llListenRemove(xh);xh=0;xb=[];}
xmenu(string p)
{
    xclose();xpage=p;xc=-20000-(integer)llFrand(1900000000.0);if(xc==XNET)xc-=4;
    xh=llListen(xc,"",llGetOwner(),"");xu=llGetUnixTime()+120;
    string text="Dream Garden transfer\n";
    if(xbusy())
    {
        text+="Transfer pending. Keep both objects rezzed nearby under the original owner. Retry is safe. Do not trade yet.";
        xb=["Retry","Close"];
        if(xs(4)!="" && llList2Integer(llJson2List(xs(4)),6)==1)xb+=["Cancel transfer"];
    }
    else if(p=="amount"){text+="Choose quantity (maximum 100).";xb=["1","5","10","100","Back","Close"];}
    else if(p=="targets")
    {
        text+="Choose receiving object:\n";xb=[];integer i;
        for(i=0;i<llGetListLength(xoffers);i+=5)
        {string n=(string)(i/5+1);text+=n+": "+llGetSubString(llList2String(xoffers,i+4),0,13)+" ("+(string)((integer)llList2Float(xoffers,i+3))+"m)\n";xb+=[n];}
        xb+=["Back","Close"];
    }
    else
    {
        text+="Arm Receive on the destination, then send from the source. Transfers use objects you own within 8m. Trade a loaded carrier through normal inventory Give or sale.";
        xb=["Seeds","Cuttings","Runners","Produce","Rootstocks","Leaves","Logs","Flowers","Move plant","Compost","Receive","Close"];
        if(isCarrier())xb=["Send contents","Receive","Close"];
    }
    llDialog(llGetOwner(),text,xb,xc);
}
xresetUI(){xclose();xscan="";xoffers=[];xpeer=NULL_KEY;xlastSend=0;}
integer xarm()
{
    if(fault || xbusy() || !cargoReady())return FALSE;
    list before=S;xput(2,[(string)llGenerateKey()]);xput(3,[llGetUnixTime()+120]);
    if(!save(before))return FALSE;
    llOwnerSay("Receive armed for two minutes. Select a sender's transfer menu now.");return TRUE;
}
xfind(string kind,integer amount,string mode)
{
    if(fault || xbusy() || !cargoReady())return;
    if(!xmemory()){if(mode=="manual")llOwnerSay("Insufficient free script memory to start a transfer. Contents are unchanged.");return;}
    string c=cargoMake(kind,amount,mode);
    if(!cargoValid(c)){if(mode=="manual")llOwnerSay("No eligible supplies or living plant for that quantity.");return;}
    xpayload=c;xmode=mode;xscan=(string)llGenerateKey();xoffers=[];xscanUntil=llGetUnixTime()+60;
    xsend(NULL_KEY,"FIND",xscan,"","",c,mode);
    if(mode=="manual")llOwnerSay("Looking for armed compatible receivers. Their selection menu appears when found.");
}
xretry()
{
    if(fault || !xbusy())return;
    list a;if(xs(4)!="")a=llJson2List(xs(4));else a=llJson2List(xs(5));
    if(llList2Key(a,2)!=llGetOwner())return;
    string op="READY";
    if(xs(4)!="")
    {integer phase=llList2Integer(a,6);op="PREPARE";if(phase==2)op="COMMIT";if(phase==3)op="ABORT";if(phase==4)op="RETIRE";}
    // Broadcast recovery resolves re-rezzed object UUIDs through persistent endpoint IDs.
    xsend(NULL_KEY,op,llList2String(a,0),llList2String(a,1),llList2String(a,3),llList2String(a,4),llList2String(a,5));
    xlastSend=llGetUnixTime();
}
xstart(integer offset)
{
    if(xbusy() || fault || llGetUnixTime()>xscanUntil || offset<0 || offset+4>=llGetListLength(xoffers) || !cargoReady())return;
    key target=llList2Key(xoffers,offset);
    if(llGetOwnerKey(target)!=llGetOwner() || !near(target,8.0))return;
    // The preview cannot substitute for a fresh stock/state check at the actual start.
    string c=cargoMake(xkind,xamount,xmode);if(!cargoValid(c))return;
    list before=S;
    xput(4,[llList2Json(JSON_ARRAY,[(string)llGenerateKey(),llList2String(xoffers,offset+1),(string)llGetOwner(),llList2String(xoffers,offset+2),c,xmode,1])]);
    xscan="";xclose();if(save(before))xretry();
}
xbutton(string message)
{
    if(message=="Close"){xclose();xscan="";return;}
    if(message=="Back"){xscan="";xmenu("main");return;}
    if(message=="Retry"){xretry();return;}
    if(message=="Cancel transfer" && xs(4)!="")
    {
        list a=llJson2List(xs(4));if(llList2Integer(a,6)!=1)return;
        list before=S;a=llListReplaceList(a,[3],6,6);xput(4,[llList2Json(JSON_ARRAY,a)]);
        if(save(before))xretry();return;
    }
    if(xbusy() || fault)return;
    if(message=="Receive"){xclose();xscan="";xarm();return;}
    if(xpage=="targets"){xstart(((integer)message-1)*5);return;}
    if(xpage=="amount")
    {xamount=(integer)message;xclose();xfind(xkind,xamount,"manual");return;}
    if(message=="Send contents"){xkind="contents";xamount=1;xclose();xfind(xkind,xamount,"manual");return;}
    list labels=["Seeds","Cuttings","Runners","Produce","Rootstocks","Leaves","Logs","Flowers","Move plant","Compost"];
    integer i=llListFindList(labels,[message]);if(i<0)return;
    xkind=llList2String(["seed","cutting","runner","produce","rootstock","leaves","logs","flower","plant","compost"],i);
    if(xkind=="plant"){xamount=1;xclose();xfind(xkind,1,"manual");return;}xmenu("amount");
}
integer xlisten(integer channel,key source,string message)
{
    if(channel==xc && source==llGetOwner())
    {if(llGetUnixTime()<xu && xownerNear() && llListFindList(xb,[message])>=0)xbutton(message);return TRUE;}
    if(channel!=XNET)return FALSE;
    if(fault || source==llGetKey() || llGetAgentSize(source)!=ZERO_VECTOR || llGetOwnerKey(source)!=llGetOwner() || !near(source,8.0))return TRUE;
    if(llStringLength(message)>1023 || llJsonValueType(message,[])!=JSON_OBJECT || llJsonGetValue(message,["v"])!="1")return TRUE;
    string op=llJsonGetValue(message,["op"]);string tx=llJsonGetValue(message,["tx"]);string sid=llJsonGetValue(message,["sid"]);
    string to=llJsonGetValue(message,["to"]);string arm=llJsonGetValue(message,["arm"]);
    string c=llJsonGetValue(message,["cargo"]);string mode=llJsonGetValue(message,["mode"]);
    if(!uuid(tx) || !uuid(sid) || sid==xs(1) || (mode!="manual" && mode!="spread"))return TRUE;
    if(op=="FIND")
    {
        if(xbusy() || !xmemory() || !xspace(sid) || !cargoValid(c) || !cargoReady() || !cargoCanReceive(c,mode))return TRUE;
        if(mode=="spread")
        {
            if(!spreadNear(source,c))return TRUE;
            if(xs(2)=="" || xi(3)<llGetUnixTime())
            {list before=S;xput(2,[(string)llGenerateKey()]);xput(3,[llGetUnixTime()+120]);if(!save(before))return TRUE;}
        }
        else if(!xownerNear())return TRUE;
        if(xs(2)!="" && xi(3)>=llGetUnixTime())xsend(source,"OFFER",tx,sid,xs(2),"",mode);
        return TRUE;
    }
    if(to!=xs(1))return TRUE;
    if(op=="OFFER")
    {
        if(xbusy() || tx!=xscan || mode!=xmode || llGetUnixTime()>xscanUntil || !uuid(arm))return TRUE;
        if(llListFindList(xoffers,[(string)source])>=0 || llGetListLength(xoffers)>=30)return TRUE;
        float distance=llVecDist(llList2Vector(llGetObjectDetails(source,[OBJECT_POS]),0),llGetPos());
        xoffers+=[(string)source,sid,arm,distance,llKey2Name(source)];
        if(mode=="manual")xmenu("targets");return TRUE;
    }
    if(op=="RETIRE")
    {
        // Sender durably acknowledged the result. Old nonces cannot reserve again;
        // retirement can be acknowledged statelessly after a lost RETIRED response.
        list a=llJson2List(xs(5));if(llList2String(a,0)==tx && llList2String(a,1)==sid)return TRUE;
        list r=llJson2List(xs(6));integer i;
        for(i=0;i<llGetListLength(r);i+=3)
        {
            if(llList2String(r,i)==sid && llList2String(r,i+1)==tx)
            {
                list before=S;r=llDeleteSubList(r,i,i+2);xput(6,[llList2Json(JSON_ARRAY,r)]);
                if(!save(before))return TRUE;
            }
        }
        xsend(source,"RETIRED",tx,sid,arm,"",mode);return TRUE;
    }
    list last=xreceipt(sid);
    if(llList2String(last,1)==tx)
    {
        if(op=="COMMIT" || op=="PREPARE" || op=="ABORT")xsend(source,llList2String(last,2),tx,sid,arm,"",mode);
        return TRUE;
    }
    if(op=="PREPARE")
    {
        if(xs(5)!="")
        {list a=llJson2List(xs(5));if(llList2String(a,0)==tx && llList2String(a,1)==sid)xretry();return TRUE;}
        if(xs(4)!="" || !xmemory() || !xspace(sid) || !uuid(arm) || arm!=xs(2) || xi(3)<llGetUnixTime() || !cargoValid(c) || !cargoReady() || !cargoCanReceive(c,mode))return TRUE;
        if(mode=="spread"){if(!spreadNear(source,c))return TRUE;}else if(!xownerNear())return TRUE;
        list before=S;xput(5,[llList2Json(JSON_ARRAY,[tx,sid,(string)llGetOwner(),arm,c,mode,1])]);xput(2,[""]);xput(3,[0]);
        xscan="";xclose();if(save(before))xretry();return TRUE;
    }
    if(op=="ABORT" && xs(4)=="")
    {
        list a=llJson2List(xs(5));
        if(xs(5)!="" && (llList2String(a,0)!=tx || llList2String(a,1)!=sid))return TRUE;
        if(!xspace(sid)){xsend(source,"ABORTED",tx,sid,arm,"",mode);return TRUE;}
        list before=S;xput(5,[""]);xput(2,[""]);xput(3,[0]);xremember(sid,tx,"ABORTED");
        if(save(before))xsend(source,"ABORTED",tx,sid,arm,"",mode);return TRUE;
    }
    if(op=="READY" && xs(4)!="")
    {
        list a=llJson2List(xs(4));if(llList2String(a,0)!=tx || llList2String(a,1)!=sid || llList2Key(a,2)!=llGetOwner())return TRUE;
        if(llList2Integer(a,6)==1)
        {
            list before=S;cargoDebit(llList2String(a,4),llList2String(a,5));a=llListReplaceList(a,[2],6,6);
            xput(4,[llList2Json(JSON_ARRAY,a)]);if(!save(before))return TRUE;
        }
        xretry();return TRUE;
    }
    if(op=="COMMIT" && xs(5)!="")
    {
        list a=llJson2List(xs(5));if(llList2String(a,0)!=tx || llList2String(a,1)!=sid || llList2Key(a,2)!=llGetOwner())return TRUE;
        list before=S;cargoCredit(llList2String(a,4));xput(5,[""]);xremember(sid,tx,"DONE");
        if(save(before)){xsend(source,"DONE",tx,sid,arm,"",mode);llOwnerSay("Transfer received and saved.");}return TRUE;
    }
    if((op=="DONE" || op=="ABORTED" || op=="RETIRED") && xs(4)!="")
    {
        list a=llJson2List(xs(4));integer p=llList2Integer(a,6);
        if(llList2String(a,0)!=tx || llList2String(a,1)!=sid || (op=="DONE" && p!=2) || (op=="ABORTED" && p!=3) || (op=="RETIRED" && p!=4))return TRUE;
        list before=S;
        if(op=="RETIRED")xput(4,[""]);
        else {a=llListReplaceList(a,[4],6,6);xput(4,[llList2Json(JSON_ARRAY,a)]);}
        if(save(before))
        {if(op=="RETIRED")llOwnerSay("Transfer settled. Carrier is safe to take or trade.");else xretry();}
        return TRUE;
    }
    return TRUE;
}
xpump()
{
    if(xh && llGetUnixTime()>=xu)xclose();
    if(fault)return;
    if(xbusy()){if(llGetUnixTime()-xlastSend>=10)xretry();return;}
    if(xscan!="" && xmode=="spread" && llGetListLength(xoffers)>0)
    {
        integer i;integer best=0;float d=100.0;
        for(i=0;i<llGetListLength(xoffers);i+=5)if(llList2Float(xoffers,i+3)<d){best=i;d=llList2Float(xoffers,i+3);}
        xstart(best);return;
    }
    if(xscan!="" && llGetUnixTime()>xscanUntil){if(xmode=="manual" && llGetListLength(xoffers)==0)llOwnerSay("No compatible receiver found. Arm Receive nearby, check species, free space and pending receipt capacity.");xscan="";xoffers=[];xclose();}
    if(xscan=="" && spreadReady())
    {xkind="runner";xamount=1;xfind("runner",1,"spread");}
}
default
{
    state_entry(){llListen(XNET,"",NULL_KEY,"");boot();}
    on_rez(integer p){boot();}
    changed(integer f){if(f & CHANGED_OWNER)boot();}
    touch_start(integer n){if(llDetectedKey(0)==llGetOwner() && xownerNear() && !fault && advance())xmenu("main");}
    listen(integer channel,string name,key source,string text){xlisten(channel,source,text);}
    timer(){xpump();advance();}
    link_message(integer sender,integer number,string text,key id)
    {
        // One trusted producer in this root, ordered sequence, persistent retry-safe credit.
        if(number!=47130 || sender!=llGetLinkNumber() || ANIMALS!=0 || fault || xbusy())return;
        if(llStringLength(text)>200 || llJsonValueType(text,[])!=JSON_OBJECT || llJsonGetValue(text,["v"])!="1" || llJsonGetValue(text,["op"])!="MANURE")return;
        string sq=llJsonGetValue(text,["seq"]);string am=llJsonGetValue(text,["amount"]);integer seq=(integer)sq;integer amount=(integer)am;
        if((string)seq!=sq || (string)amount!=am || seq<1 || seq>1000000000 || amount<1 || amount>100)return;
        if(seq==bi(6) && amount==bi(7))
        {llMessageLinked(LINK_THIS,47131,llList2Json(JSON_OBJECT,["v",1,"op","ACK","seq",seq]),id);return;}
        if(seq!=bi(6)+1 || bi(2)>1000-amount)return;
        list before=S;bput(2,[bi(2)+amount]);bput(6,[seq]);bput(7,[amount]);
        if(save(before))llMessageLinked(LINK_THIS,47131,llList2Json(JSON_OBJECT,["v",1,"op","ACK","seq",seq]),id);
    }
}
