// GENERATED by tools/build.py. Edit src/, then rebuild.
// Read-only local farm monitor. Register up to 16 same-owner object roots.
string DATA="dreamfarm:board:v1";string KIND="FARM BOARD";
integer SCHEMA=1;integer OUT=12;integer BASE=17;
integer polled;string nonce;list readings;
// 8 registered UUID array;9 selected;10 reserved;11 reserved.
fresh(){S=header()+["[]",0,0,0]+outbox();}
list migrate(list v){return v;}
list nodes(){return llJson2List(sv(8));}
integer validSpecific(list v)
{
    list n=llJson2List(llList2String(v,8));if(llJsonValueType(llList2String(v,8),[])!=JSON_ARRAY || llGetListLength(n)>16)return FALSE;
    integer i;list seen=[];for(i=0;i<llGetListLength(n);++i){string k=llList2String(n,i);if(!uuid(k) || llListFindList(seen,[k])>=0)return FALSE;seen+=[k];}
    return whole(v,9,0,15) && (llGetListLength(n)==0 || llList2Integer(v,9)<llGetListLength(n)) && whole(v,10,0,0) && whole(v,11,0,0);
}
tick(float dt){}
integer reading(string id)
{integer i;for(i=0;i<llGetListLength(readings);i+=5)if(llList2String(readings,i)==id)return i;return -1;}
string summary()
{
    string t="Registered farm objects: "+(string)llGetListLength(nodes())+" / 16";
    if(llGetListLength(nodes())==0)return t+"\nAdd nearby same-owner root UUIDs.";
    string id=llList2String(nodes(),iv(9));integer i=reading(id);t+="\nNode "+(string)(iv(9)+1)+": "+id;
    if(i<0)return t+"\nAwaiting a reply; no current reading.";
    integer age=llGetUnixTime()-llList2Integer(readings,i+4);
    if(age>60)t+="\nSTALE: "+(string)age+" seconds old";
    return t+"\n"+llList2String(readings,i+1)+" | Locked "+llList2String(readings,i+3)+"\n"+llGetSubString(llList2String(readings,i+2),0,230);
}
list buttons(string p)
{if(p=="settings")return ["Pause","Resume","Back","Close"];return ["Add node","Next node","Remove node","Refresh","Details","Settings","Close"];}
string action(string c)
{
    if(page=="add")
    {
        page="main";if(!uuid(c) || c==(string)llGetKey() || !near((key)c,96.0) || llGetOwnerKey((key)c)!=llGetOwner() || llGetAgentSize((key)c)!=ZERO_VECTOR)return "Enter a nearby same-owner object root UUID.";
        list n=nodes();if(llGetListLength(n)>=16 || llListFindList(n,[c])>=0)return "Already registered or board full.";
        n+=[c];put(8,[llList2Json(JSON_ARRAY,n)]);put(9,[llGetListLength(n)-1]);polled=0;return "Node registered.";
    }
    if(c=="Add node"){page="add";return "";}
    if(c=="Next node" && llGetListLength(nodes())>0)put(9,[(iv(9)+1)%llGetListLength(nodes())]);
    if(c=="Remove node" && llGetListLength(nodes())>0)
    {put(8,[llList2Json(JSON_ARRAY,llDeleteSubList(nodes(),iv(9),iv(9)))]);put(9,[0]);readings=[];}
    if(c=="Refresh")polled=0;
    if(c=="Details"){integer i=reading(llList2String(nodes(),iv(9)));if(i>=0)return llList2String(readings,i+2);return "No reading.";}
    return "";
}
service()
{
    if(fault || iv(4) || llGetUnixTime()-polled<30)return;polled=llGetUnixTime();nonce=(string)llGenerateKey();
    string msg=llList2Json(JSON_OBJECT,["v",1,"op","QUERY","nonce",nonce]);integer i;
    for(i=0;i<llGetListLength(nodes());++i){key k=llList2Key(nodes(),i);if(near(k,96.0) && llGetOwnerKey(k)==llGetOwner())llRegionSayTo(k,DASH,msg);}
}
integer extraListen(integer c,key who,string msg)
{
    if(c!=DASH)return FALSE;
    if(fault || llStringLength(msg)>1000 || llGetUnixTime()-polled>30 || llListFindList(nodes(),[(string)who])<0 || !near(who,96.0) || llGetOwnerKey(who)!=llGetOwner())return TRUE;
    if(llJsonValueType(msg,[])!=JSON_OBJECT || llJsonGetValue(msg,["v"])!="1" || llJsonGetValue(msg,["op"])!="STATUS" || llJsonGetValue(msg,["nonce"])!=nonce)return TRUE;
    integer f=(integer)llJsonGetValue(msg,["fault"]);if(llListFindList(["0","1"],[llJsonGetValue(msg,["fault"])])<0)return TRUE;
    list r=[(string)who,llGetSubString(llJsonGetValue(msg,["kind"]),0,24),llGetSubString(llJsonGetValue(msg,["text"]),0,450),f,llGetUnixTime()];integer i=reading((string)who);
    if(i<0)readings+=r;else readings=llListReplaceList(readings,r,i,i+4);return TRUE;
}
integer credit(string kind,integer qty){return FALSE;}
string visual(){return llList2Json(JSON_OBJECT,["kind",KIND,"nodes",llGetListLength(nodes()),"fault",fault]);}
extraBoot(){}
extraLink(integer sender,integer number,string text,key id){}
integer textPage(string p){return p=="add";}
string textPrompt(){return "Paste a same-owner farm object's root UUID within 96 m.";}
// Dream Farming 0.2.0 alpha. Project and creator credit: Romeo Dream.
// Cooperative roleplay; local persistent state, no external server or currency.
integer NET = -163847025;
integer VIEW = 48100;
list S;
integer fault;
integer handle;
integer channel;
integer expires;
string page = "main";
list offered;
integer inputMode;
integer txLast;
key visitor;
integer GROUP_WORK=FALSE; // opt-in active-group farm workers; owner retains settings/stock transfers
integer DASH=-163847029;
integer UI_TOUCH=TRUE;
integer UI_HOVER=TRUE;

integer iv(integer i) { return llList2Integer(S,i); }
float fv(integer i) { return llList2Float(S,i); }
string sv(integer i) { return llList2String(S,i); }
put(integer i,list x) { S=llListReplaceList(S,x,i,i); }
float clamp(float x,float lo,float hi) { if(x<lo)return lo;if(x>hi)return hi;return x; }
float low(float a,float b) { if(a<b)return a;return b; }
integer uuid(string v) { return llStringLength(v)==36 && (key)v!=NULL_KEY; }
string clipBytes(string text,integer budget)
{
    while(llStringLength(llStringToBase64(text))>(budget/3)*4)text=llDeleteSubString(text,-1,-1);
    return text;
}
integer near(key who,float reach)
{
    list d=llGetObjectDetails(who,[OBJECT_POS]);
    if(llGetListLength(d)!=1)return FALSE;
    return llVecDist(llList2Vector(d,0),llGetPos())<=reach;
}
integer permitted(key who)
{
    if(llGetAgentSize(who)==ZERO_VECTOR || !near(who,8.0))return FALSE;
    if(who==llGetOwner())return TRUE;
    return GROUP_WORK && llList2Key(llGetObjectDetails(llGetKey(),[OBJECT_GROUP]),0)!=NULL_KEY && llSameGroup(who);
}
integer workerCommand(string cmd)
{return llListFindList(["Plow","Plant","Harvest","Soil care","Water","Weed","Treat pests","Muck out","Collect produce","Turn pile","Water pile","Dry pile","Start batch","Run batch","Start job","Finish job","Next job","Status","Back","Close","Wheat","Corn","Soybean","Potato","Sunflower","Grass"],[cmd])>=0;}
integer ownerNear()
{return llGetAgentSize(llGetOwner())!=ZERO_VECTOR && near(llGetOwner(),8.0);}
integer save(list before)
{
    integer r=llLinksetDataWrite(DATA,llList2Json(JSON_ARRAY,S));
    if(r==LINKSETDATA_OK || r==LINKSETDATA_NOUPDATE)return TRUE;
    S=before;fault=TRUE;
    llOwnerSay("Storage write failed. Actions locked; repair storage, then reset. Saved data was preserved.");
    return FALSE;
}
integer numeric(list v,integer i,float lo,float hi)
{
    integer t=llGetListEntryType(v,i);
    if(t!=TYPE_INTEGER && t!=TYPE_FLOAT)return FALSE;
    float n=llList2Float(v,i);
    return n>=lo && n<=hi;
}
integer whole(list v,integer i,integer lo,integer hi)
{return llGetListEntryType(v,i)==TYPE_INTEGER && llList2Integer(v,i)>=lo && llList2Integer(v,i)<=hi;}
integer validBase(list v)
{
    integer n=llGetListLength(v);
    if(n<BASE || n>BASE+32 || (n-BASE)%4)return FALSE;
    if(!whole(v,0,SCHEMA,SCHEMA) || llList2String(v,2)!=KIND || !uuid(llList2String(v,1)))return FALSE;
    if(!whole(v,3,1,2147483647) || !whole(v,4,0,1))return FALSE;
    if(llList2Integer(v,5)!=1 && llList2Integer(v,5)!=60)return FALSE;
    if(!whole(v,5,1,60) || !numeric(v,6,0.0,1000000.0) || !whole(v,7,0,2147483647))return FALSE;
    if(llList2String(v,OUT)!="" && !uuid(llList2String(v,OUT)))return FALSE;
    if(!whole(v,OUT+1,0,1000000000) || !whole(v,OUT+2,0,1000))return FALSE;
    if(llGetListEntryType(v,OUT+3)!=TYPE_STRING || !uuid(llList2String(v,OUT+4)))return FALSE;
    if(llList2Integer(v,OUT+2)>0 && (llList2String(v,OUT)=="" || llList2Integer(v,OUT+1)==0))return FALSE;
    list seen=[];integer i;
    for(i=BASE;i<n;i+=4)
    {
        string id=llList2String(v,i);
        if(!uuid(id) || llListFindList(seen,[id])>=0)return FALSE;
        seen+=[id];
        if(!whole(v,i+1,1,1000000000) || !whole(v,i+2,1,1000))return FALSE;
        if(llGetListEntryType(v,i+3)!=TYPE_STRING)return FALSE;
    }
    return TRUE;
}
list header()
{return [SCHEMA,(string)llGetOwner(),KIND,llGetUnixTime(),0,1,0.0,0];}
list outbox() { return ["",0,0,"",(string)llGenerateKey()]; }
integer startTransfer(string kind,integer qty)
{
    if(iv(OUT+2)>0 || !uuid(sv(OUT)) || iv(OUT+1)>=1000000000)return FALSE;
    if(!near((key)sv(OUT),8.0) || llGetOwnerKey((key)sv(OUT))!=llGetOwner())return FALSE;
    put(OUT+1,[iv(OUT+1)+1]);put(OUT+2,[qty]);put(OUT+3,[kind]);return TRUE;
}
sendTransfer()
{
    if(fault || iv(OUT+2)==0 || llGetUnixTime()-txLast<10)return;
    txLast=llGetUnixTime();
    llRegionSayTo((key)sv(OUT),NET,llList2Json(JSON_OBJECT,["v",1,"op","LOAD",
        "target",sv(OUT),"stream",sv(OUT+4),"seq",iv(OUT+1),"qty",iv(OUT+2),"kind",sv(OUT+3)]));
}
replyLoad(key who,string stream,integer seq,integer qty,string kind)
{llRegionSayTo(who,NET,llList2Json(JSON_OBJECT,["v",1,"op","ACK","target",(string)who,
 "stream",stream,"seq",seq,"qty",qty,"kind",kind]));}
close()
{if(handle)llListenRemove(handle);handle=0;expires=0;offered=[];inputMode=FALSE;}
show(string p)
{
    close();page=p;channel=-10000-(integer)llFrand(1900000000.0);
    if(visitor==NULL_KEY)visitor=llGetOwner();
    handle=llListen(channel,"",visitor,"");expires=llGetUnixTime()+45;
    if(p=="target")
    {inputMode=TRUE;llTextBox(llGetOwner(),"Paste destination object's root UUID. Pending deliveries must finish before changing destination.",channel);return;}
    if(textPage(p)){inputMode=2;llTextBox(visitor,textPrompt(),channel);return;}
    offered=buttons(p);
    if(p=="settings")offered+=["Diagnostics"];
    if(visitor!=llGetOwner())
    {list filtered=[];integer k;for(k=0;k<llGetListLength(offered);++k)if(workerCommand(llList2String(offered,k)))filtered+=[llList2String(offered,k)];offered=filtered;}
    llDialog(visitor,clipBytes(llGetSubString(summary(),0,450),450),offered,channel);
}
integer advance()
{
    if(fault)return FALSE;
    integer now=llGetUnixTime();integer elapsed=now-iv(3);
    if(elapsed<0){fault=TRUE;llOwnerSay("Clock moved backwards. State preserved; wait for clock recovery and reset.");return FALSE;}
    if(elapsed==0)return TRUE;
    list before=S;
    if(iv(4)){put(3,[now]);return save(before);}
    // Fixed time slices retain unprocessed backlog; >24 h absence freezes the excess.
    if(elapsed>86400)
    {put(7,[iv(7)+elapsed-86400]);put(3,[now-86400]);elapsed=86400;}
    integer step=150;if(iv(5)==60)step=5;
    integer count=0;
    while(elapsed>=step && count<8)
    {
        float days=(float)(step*iv(5))/3600.0;
        tick(days);put(6,[fv(6)+days]);put(3,[iv(3)+step]);elapsed-=step;++count;
    }
    if(!save(before))return FALSE;
    return elapsed<step;
}
receive(key source,string msg)
{
    if(fault || llStringLength(msg)>1000 || llJsonValueType(msg,[])!=JSON_OBJECT)return;
    if(llJsonGetValue(msg,["v"])!="1" || llJsonGetValue(msg,["target"])!=(string)llGetKey())return;
    if(llGetAgentSize(source)!=ZERO_VECTOR || llGetOwnerKey(source)!=llGetOwner() || !near(source,8.0))return;
    string op=llJsonGetValue(msg,["op"]);string id=llJsonGetValue(msg,["stream"]);
    string kind=llJsonGetValue(msg,["kind"]);
    if(!uuid(id) || llJsonValueType(msg,["seq"])!=JSON_NUMBER || llJsonValueType(msg,["qty"])!=JSON_NUMBER)return;
    integer seq=(integer)llJsonGetValue(msg,["seq"]);integer qty=(integer)llJsonGetValue(msg,["qty"]);
    if((float)llJsonGetValue(msg,["seq"])!=(float)seq || (float)llJsonGetValue(msg,["qty"])!=(float)qty)return;
    if(seq<1 || seq>1000000000 || qty<1 || qty>1000)return;
    if(op=="ACK")
    {
        if(source!=(key)sv(OUT) || id!=sv(OUT+4) || seq!=iv(OUT+1) || qty!=iv(OUT+2) || kind!=sv(OUT+3))return;
        list before=S;put(OUT+2,[0]);if(save(before))llOwnerSay("Delivery confirmed: "+kind+" "+(string)qty);return;
    }
    if(op!="LOAD")return;
    integer i;integer found=-1;
    for(i=BASE;i<llGetListLength(S);i+=4)if(sv(i)==id)found=i;
    if(found>=0 && seq<=iv(found+1))
    {
        if(seq==iv(found+1) && (qty!=iv(found+2) || kind!=sv(found+3)))return;
        replyLoad(source,id,seq,qty,kind);return;
    }
    if(found<0 && llGetListLength(S)>=BASE+32)return; // Never evict receipts.
    if(!advance() || iv(4))return;
    list before=S;
    if(!credit(kind,qty)){S=before;return;}
    if(found<0)S+=[id,seq,qty,kind];
    else S=llListReplaceList(S,[id,seq,qty,kind],found,found+3);
    if(save(before))replyLoad(source,id,seq,qty,kind);
}
render()
{
    string text="LOCKED: saved state needs owner repair.";
    if(!fault)text=summary();
    if(UI_HOVER)llSetText("Dream Farming - "+KIND+"\n"+text,<0.5,0.9,0.4>,1.0);
    if(!fault)llMessageLinked(LINK_SET,VIEW,visual(),NULL_KEY);
}
boot()
{
    close();fault=FALSE;string raw=llLinksetDataRead(DATA);
    if(raw=="")
    {
        fresh();
        if(!validBase(S) || !validSpecific(S))
        {fault=TRUE;llOwnerSay("Invalid initial configuration. Correct script settings before starting.");render();return;}
        if(!save([]))return;
    }
    else
    {
        S=migrate(llJson2List(raw));
        if(llJsonValueType(raw,[])!=JSON_ARRAY || !validBase(S) || !validSpecific(S) || sv(1)!=(string)llGetOwner())
        {fault=TRUE;llOwnerSay("Invalid, incompatible, or other-owner record. Preserved without changes. Restore the correct script/owner or use a fresh object.");}
        else if(llList2Integer(llJson2List(raw),0)!=SCHEMA)save(llJson2List(raw));
    }
    llListen(NET,"",NULL_KEY,"");llListen(DASH,"",NULL_KEY,"");extraBoot();llSetTimerEvent(15.0);
    if(!fault){advance();service();}render();
}
default
{
    state_entry(){boot();}
    on_rez(integer start){llResetScript();}
    changed(integer change){if(change & CHANGED_OWNER)llResetScript();}
    touch_start(integer count)
    {
        if(!UI_TOUCH || !permitted(llDetectedKey(0)) || fault)return;
        visitor=llDetectedKey(0);
        if(!advance()){llOwnerSay("Catching up saved farm time. Try again shortly.");return;}
        show("main");render();
    }
    listen(integer c,string name,key who,string msg)
    {
        if(c==DASH && llJsonGetValue(msg,["op"])=="QUERY")
        {
            if(llStringLength(msg)>200 || llJsonValueType(msg,[])!=JSON_OBJECT || llJsonGetValue(msg,["v"])!="1" || !uuid(llJsonGetValue(msg,["nonce"])) || llGetOwnerKey(who)!=llGetOwner() || llGetAgentSize(who)!=ZERO_VECTOR || !near(who,96.0))return;
            string text="LOCKED";if(!fault)text=summary();
            llRegionSayTo(who,DASH,llList2Json(JSON_OBJECT,["v",1,"op","STATUS","nonce",llJsonGetValue(msg,["nonce"]),"kind",KIND,"text",llGetSubString(text,0,450),"fault",fault]));return;
        }
        if(c==NET){receive(who,msg);render();return;}
        if(extraListen(c,who,msg)){render();return;}
        if(fault || c!=channel || who!=visitor || llGetUnixTime()>=expires || !permitted(who))return;
        if(!inputMode && llListFindList(offered,[msg])<0)return;
        if(who!=llGetOwner() && (!workerCommand(msg) || inputMode))return;
        integer input=inputMode;close();
        if(!advance()){llOwnerSay("Catching up saved farm time. Try again shortly.");return;}
        if(msg=="Close")return;
        if(msg=="Back"){show("main");return;}
        list before=S;string result="";
        if(input==2)result=action(msg);
        else if(input==1)
        {
            if(iv(OUT+2)>0)result="Delivery pending; destination is locked.";
            else if(uuid(msg)){put(OUT,[msg]);result="Destination saved.";}else result="Invalid UUID.";
            page="main";
        }
        else if(msg=="Settings")page="settings";
        else if(msg=="Destination")page="target";
        else if(msg=="Pause"){put(4,[1]);put(3,[llGetUnixTime()]);}
        else if(msg=="Resume"){put(4,[0]);put(3,[llGetUnixTime()]);}
        else if(msg=="Normal"){put(5,[1]);put(3,[llGetUnixTime()]);}
        else if(msg=="Demo x60"){put(5,[60]);put(3,[llGetUnixTime()]);}
        else if(msg=="Diagnostics")result="Free script memory: "+(string)llGetFreeMemory()+" bytes; saved JSON: "+(string)llStringLength(llList2Json(JSON_ARRAY,S))+" characters; frozen offline seconds: "+(string)iv(7)+"; pending load: "+(string)iv(OUT+2);
        else if(iv(4))result="Paused. Resume before working.";
        else result=action(msg);
        if(save(before))
        {if(result!="")llOwnerSay(result);service();show(page);}
        render();
    }
    timer()
    {
        if(handle && llGetUnixTime()>=expires)close();
        if(!fault){advance();service();}render();
    }
    link_message(integer sender,integer number,string text,key id)
    {if(number==VIEW+1)render();else extraLink(sender,number,text,id);}
}

