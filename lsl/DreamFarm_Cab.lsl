// GENERATED by tools/build.py. Edit src/, then rebuild.
// Romeo Dream - named physical controls and indicators for DreamFarm_Machine.
// Put beside Machine in SAME ROOT. Only explicitly named children are changed.
// Needle zero orientations are local to the root; adjust for your gauge mesh.
rotation FUEL_ZERO=ZERO_ROTATION;
rotation WEAR_ZERO=ZERO_ROTATION;
float NEEDLE_SWEEP=3.14159265;
integer seen;integer stale=TRUE;string latest;
integer ownerNear()
{
    list p=llGetObjectDetails(llGetOwner(),[OBJECT_POS]);
    return llGetAgentSize(llGetOwner())!=ZERO_VECTOR && llGetListLength(p)==1 && llVecDist(llList2Vector(p,0),llGetPos())<=8.0;
}
float bounded(float n,float top){if(n<0.0)return 0.0;if(n>top)return top;return n;}
string command(string name)
{
    if(name=="DF:Control:Engine")return "Engine";
    if(name=="DF:Control:PTO")return "PTO";
    if(name=="DF:Control:Hydraulics")return "Hydraulics";
    if(name=="DF:Control:Hitch")return "Hitch";
    if(name=="DF:Control:Lift")return "Lower or raise";
    return "";
}
paint(string msg)
{
    integer i;for(i=2;i<=llGetNumberOfPrims();++i)
    {
        string name=llGetLinkName(i);string property="";
        if(name=="DF:Light:Engine")property="engine";
        if(name=="DF:Light:PTO")property="pto";
        if(name=="DF:Light:Hitch")property="hitch";
        if(name=="DF:Light:Hydraulics")property="hydraulics";
        if(name=="DF:Light:Pending")property="pending";
        if(name=="DF:Light:ExternalFuel")property="external_fuel";
        if(name=="DF:Light:Fault")property="fault";
        if(property!="")
        {
            integer lit=(integer)llJsonGetValue(msg,[property])>0;vector color=<0.12,0.12,0.12>;float glow=0.0;
            if(stale)lit=FALSE;if(property=="fault" && stale)lit=TRUE;
            if(lit){color=<0.2,0.9,0.2>;glow=0.1;if(property=="pending" || property=="external_fuel")color=<1.0,0.6,0.1>;}
            if(lit && property=="fault")color=<1.0,0.1,0.1>;
            llSetLinkPrimitiveParamsFast(i,[PRIM_COLOR,ALL_SIDES,color,1.0,PRIM_GLOW,ALL_SIDES,glow]);
        }
        if(!stale && name=="DF:Gauge:Fuel" && llJsonGetValue(msg,["external_fuel"])=="0")
        {float fraction=bounded((float)llJsonGetValue(msg,["fuel"]),250.0)/250.0;llSetLinkPrimitiveParamsFast(i,[PRIM_ROT_LOCAL,llEuler2Rot(<0.0,0.0,fraction*NEEDLE_SWEEP>)*FUEL_ZERO]);}
        if(!stale && name=="DF:Gauge:Wear")
        {float fraction=bounded((float)llJsonGetValue(msg,["wear"]),100.0)/100.0;llSetLinkPrimitiveParamsFast(i,[PRIM_ROT_LOCAL,llEuler2Rot(<0.0,0.0,fraction*NEEDLE_SWEEP>)*WEAR_ZERO]);}
    }
}
default
{
    state_entry(){paint("{}");llSetTimerEvent(5.0);llMessageLinked(LINK_THIS,48101,"",NULL_KEY);}
    on_rez(integer p){llResetScript();}
    changed(integer c){if(c & CHANGED_OWNER)llResetScript();if(c & CHANGED_LINK)llMessageLinked(LINK_THIS,48101,"",NULL_KEY);}
    timer(){if(!stale && llGetUnixTime()-seen>30){stale=TRUE;paint(latest);}}
    touch_start(integer n)
    {
        if(llDetectedKey(0)!=llGetOwner() || !ownerNear())return;
        string cmd=command(llGetLinkName(llDetectedLinkNumber(0)));if(cmd=="")return;
        llMessageLinked(LINK_THIS,48300,llList2Json(JSON_OBJECT,["v",1,"actor",(string)llGetOwner(),"cmd",cmd]),llGetOwner());
    }
    link_message(integer sender,integer number,string text,key id)
    {
        if(sender!=llGetLinkNumber() || number!=48100 || llJsonValueType(text,[])!=JSON_OBJECT || llJsonGetValue(text,["kind"])!="MACHINE")return;
        latest=text;seen=llGetUnixTime();stale=FALSE;paint(text);
    }
}
